{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 120,
  "ignorePatterns": [
    ".output",
    ".wxt",
    "patches",
    "src/components/ui",
    "src/components/magicui",
    "src/lib/uglyAvatar",
    "docs/architecture/*.html",
    "tools/oxlint/anti-slop/**"
  ],
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["clsx"]
  }
}
