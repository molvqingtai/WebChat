{
  "name": "web-chat",
  "displayName": "WebChat",
  "version": "2.8.3",
  "description": "Chat with anyone on any website.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "cross-env NODE_ENV=production run-p build:*",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:chrome": "wxt zip -b chrome",
    "pack:firefox": "wxt zip -b firefox",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint .",
    "clear": "rimraf .output node_modules",
    "test": "vitest run",
    "test:tools": "node --test --experimental-strip-types tools/oxlint/anti-slop/*/*.test.ts tools/oxlint/anti-slop/*/*/*.test.ts",
    "test:e2e:chrome": "cross-env NODE_ENV=production pnpm build:chrome && node e2e/chrome-runtime.ts",
    "check": "wxt prepare && tsc --noEmit && tsc -p tsconfig.core.json",
    "prepare": "husky",
    "postinstall": "wxt prepare"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molvqingtai/WebChat.git"
  },
  "keywords": [
    "WebChat",
    "Chat",
    "Browser",
    "Browser Extension",
    "Chrome",
    "Chrome Extension",
    "Firefox",
    "Firefox Extension",
    "Extension",
    "WebRTC",
    "P2P",
    "Peer to Peer"
  ],
  "author": "molvqingtai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/molvqingtai/WebChat/issues"
  },
  "homepage": "https://github.com/molvqingtai/WebChat",
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-portal": "^1.2.0",
    "@radix-ui/react-presence": "^1.1.11",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@resreq/event-hub": "^1.7.2",
    "@rtco/client": "0.3.7",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@webcomponents/custom-elements": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "comctx": "^1.7.7",
    "core-js": "^3.51.0",
    "danmu": "^0.20.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.12.0",
    "hash-it": "^7.1.1",
    "idb": "^8.0.4",
    "idb-keyval": "^6.3.0",
    "imgcap": "^1.1.0",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-use": "^17.6.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remesh": "^4.2.2",
    "remesh-logger": "^4.1.0",
    "remesh-react": "^4.1.2",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "trystero": "0.26.0",
    "type-fest": "^5.10.0",
    "unstorage": "^2.0.0-beta.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@oxlint/plugins": "1.93.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "postcss-rem-to-responsive-pixel": "^7.0.9",
    "rimraf": "^6.1.4",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0",
    "wxt": "^0.21.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0",
    "pnpm": "^12.16.1"
  }
}
